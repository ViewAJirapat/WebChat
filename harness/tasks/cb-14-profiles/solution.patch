+def _profile_json(db: Db, me: int, row: dict[str, Any]) -> dict[str, Any]:
+    uid = int(row["id"])
+    rel = relationship(db, me, uid)
+    if rel == "request_sent":
+        rid = db.value("SELECT id FROM friend_requests WHERE from_id = ? AND to_id = ?", me, uid)
+    elif rel == "request_received":
+        rid = db.value("SELECT id FROM friend_requests WHERE from_id = ? AND to_id = ?", uid, me)
+    else:
+        rid = None
+    return {
+        "id": uid,
+        "username": row["username"],
+        "display_name": row["display_name"],
+        "bio": row["bio"],
+        "joined_at": row["created_at"],
+        "relationship": rel,
+        "friend_count": len(friend_ids(db, uid)),
+        "request_id": rid,
+    }
 
 
