+def post_json(db: Db, row: dict[str, Any], me: int) -> dict[str, Any]:
+    pid = row["id"]
+    return {
+        "id": pid,
+        "author": user_json(require_user(db, row["author_id"])),
+        "body": row["body"],
+        "created_at": row["created_at"],
+        "like_count": int(db.value("SELECT COUNT(*) FROM likes WHERE post_id = ?", pid)),
+        "comment_count": int(db.value("SELECT COUNT(*) FROM comments WHERE post_id = ?", pid)),
+        "liked": db.one("SELECT 1 FROM likes WHERE post_id = ? AND user_id = ?", pid, me)
+        is not None,
+    }
 
 
