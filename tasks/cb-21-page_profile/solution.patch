diff --git a/src/chatbook/features/page_profile/ui.js b/src/chatbook/features/page_profile/ui.js
index a96501e..e3a140e 100644
--- a/src/chatbook/features/page_profile/ui.js
+++ b/src/chatbook/features/page_profile/ui.js
@@ -28,9 +28,73 @@
 //       button 'Unfriend': await CB.api('DELETE', '/api/friends/' + u.id); CB.refresh())
 // Server answer: {user: {id, username, display_name, bio, joined_at, relationship, friend_count,
 // request_id}}.
+function actions(u) {
+  if (u.relationship === 'self') {
+    return CB.form({
+      fields: [
+        {name: 'display_name', label: 'Display name', value: u.display_name},
+        {name: 'bio', label: 'Bio', type: 'textarea', value: u.bio},
+      ],
+      submit: 'Save profile',
+      onsubmit: async (v) => {
+        await CB.api('PUT', '/api/profile', {display_name: v.display_name, bio: v.bio});
+        CB.toast('Profile saved');
+        await CB.reloadMe();
+        CB.refresh();
+      },
+    });
+  }
+  if (u.relationship === 'none') {
+    return CB.el('button', {
+      onclick: async () => {
+        await CB.api('POST', '/api/friends/requests', {user_id: u.id});
+        CB.refresh();
+      },
+    }, 'Add friend');
+  }
+  if (u.relationship === 'request_sent') {
+    return CB.el('button', {
+      onclick: async () => {
+        await CB.api('DELETE', '/api/friends/requests/' + u.request_id);
+        CB.refresh();
+      },
+    }, 'Cancel request');
+  }
+  if (u.relationship === 'request_received') {
+    return CB.el('button', {
+      onclick: async () => {
+        await CB.api('POST', '/api/friends/requests/' + u.request_id + '/accept');
+        CB.refresh();
+      },
+    }, 'Accept');
+  }
+  if (u.relationship === 'friends') {
+    return CB.el('div', {class: 'row'},
+      CB.el('button', {
+        onclick: async () => {
+          const r = await CB.api('POST', '/api/dm', {user_id: u.id});
+          CB.go('chat', {id: r.conversation.id});
+        },
+      }, 'Message'),
+      CB.el('button', {
+        onclick: async () => {
+          await CB.api('DELETE', '/api/friends/' + u.id);
+          CB.refresh();
+        },
+      }, 'Unfriend'));
+  }
+  return null;
+}
+
 CB.page('profile', {
   title: 'Profile',
   nav: 'Profile',
   order: 50,
-  render: () => CB.el('p', {class: 'muted'}, 'Coming soon'),
+  load: async (params) => (await CB.api('GET', '/api/users/' + (params.id || CB.me.id))).user,
+  render: (u) => CB.el('div', {class: 'stack'},
+    CB.el('div', {class: 'row'}, CB.avatar(u), CB.el('h2', {}, u.display_name)),
+    CB.el('div', {class: 'muted'}, '@' + u.username),
+    CB.el('p', {}, u.bio || 'No bio yet'),
+    CB.el('div', {class: 'muted'}, CB.plural(u.friend_count, 'friend')),
+    actions(u)),
 });
